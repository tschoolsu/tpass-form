// tpass-form 資料模型。表單本體用 JSONB document 存定義（題型多變、要好版本控管，
// 正規化成一堆題目表是自找麻煩）。真相來源是這個 Postgres；Google Sheet 只做匯出鏡像。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 學生會 email 白名單（超管種子來自 env，不入此表）。

model Form {
  id          String     @id @default(cuid())
  slug        String     @unique // 公開連結用，亂數短碼
  title       String
  description String?
  status      String     @default("draft") // draft | published | closed
  ownerSub    String // 建立者 JWT sub（僅供顯示，非門禁；admin 皆可維護所有問卷）
  ownerEmail  String
  definition  Json // 有序 blocks（section_break / text_block / question）
  settings    Json // anonymous / identityFields / theme / cover / acceptingResponses
  version     Int        @default(0) // 樂觀鎖：存檔時 compare-and-swap，擋同時編輯的靜默覆蓋
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?
  responses   Response[]
  drafts      ResponseDraft[]
  assets      FormAsset[]

  @@index([status])
  @@index([ownerSub])
}

model Response {
  id              String   @id @default(cuid())
  formId          String
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  respondentSub   String? // 匿名 → null
  anonHash        String? // 匿名但要防重複時：sha256(sub + formId + secret)
  respondentEmail String?
  respondentName  String?
  respondentGrade Int? // 由 email 推導
  answers         Json // { [questionId]: value }
  submittedAt     DateTime @default(now())

  @@unique([formId, respondentSub])
  @@unique([formId, anonHash])
  @@index([formId])
}

// 填寫進度草稿（自動儲存）。一份表單 × 一個填寫者最多一列；送出成功即刪。
// ownerKey 是 sha256(sub:formId:secret)，不存明文 sub —— 匿名問卷的草稿因此也無法反查身分，
// 而且匿名 / 非匿名走同一條路徑，不用分支。
model ResponseDraft {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  ownerKey  String
  answers   Json // { [questionId]: value }，形狀同 Response.answers
  history   Json // string[]：section id 堆疊，用來還原「填到第幾段」
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, ownerKey])
  @@index([formId])
}

// 檔案上傳：提交前先傳，answers 內存 upload id 參照。
model Upload {
  id          String   @id @default(cuid())
  formId      String
  questionId  String
  storageKey  String // 物件儲存 key
  filename    String
  mime        String
  size        Int
  uploaderSub String
  createdAt   DateTime @default(now())

  @@index([formId])
}

// 說明欄的插圖：問卷「內容」的一部分，由建構者上傳，任何登入者都看得到。
// 刻意不跟 Upload 共用一張表 —— Upload 是填寫者的回覆附件（個資，只有問卷擁有者/超管能下載），
// 兩者的授權方向相反，混在一起只會讓讀取端長出一堆 if。
// width/height 存下來是給 <img> 固定長寬比，避免圖載入時卡片跳動。
model FormAsset {
  id         String   @id @default(cuid())
  formId     String
  form       Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  storageKey String
  mime       String // 一律 image/webp（上傳時就轉好）
  width      Int
  height     Int
  size       Int
  createdBy  String // 上傳者 JWT sub
  createdAt  DateTime @default(now())

  @@index([formId])
}

// 通知目標（Google Chat / Discord 的 incoming webhook）。
// 先在 /admin/webhooks 登記好幾個，之後每份問卷自己挑要不要通知——
// 大量回覆的問卷關掉，回報表單那種「不會有人定期檢查」的才開。
//
// ⚠️ 通知**只送辨識資訊，不送答案內容**（同 tpass-appeals 的 A4 鐵律，見 src/lib/webhooks.ts）。
// url 內含 secret：後台只顯示截斷版，錯誤訊息與 log 一律不得帶出完整 URL。
model Webhook {
  id         String    @id @default(cuid())
  name       String
  url        String
  enabled    Boolean   @default(true)
  createdBy  String // 建立者 email（稽核用）
  createdAt  DateTime  @default(now())
  // 最後一次投遞結果，純粹給後台排錯看（例如群組被刪掉 → 一直 404）。
  lastStatus String?
  lastSentAt DateTime?

  @@index([createdAt])
}
